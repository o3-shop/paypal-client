{
    "name": "o3-shop/paypal-client",
    "description": "O3-Shop PayPal Checkout API client (fork of oxid-solution-catalysts/paypal-client)",
    "type": "library",
    "license": "GPL-3.0-only",
    "homepage": "https://www.o3-shop.com/",
    "authors": [
        {
            "name": "O3-Shop",
            "email": "info@o3-shop.com",
            "homepage": "https://www.o3-shop.com",
            "role": "Developer"
        },
        {
            "name": "OXID eSales AG",
            "email": "info@oxid-esales.com",
            "homepage": "https://oxid-esales.com",
            "role": "Developer"
        }
    ],
    "replace": {
        "oxid-solution-catalysts/paypal-client": "self.version"
    },
    "require": {
        "php": ">=7.1",
        "guzzlehttp/guzzle": "~7",
        "psr/log": "^1.1",
        "monolog/monolog": "^1.27 || ^2.0",
        "league/oauth2-client": "^2.4",
        "webmozart/assert": "^1.7 || ^1.8 || ^1.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5.20",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "OxidSolutionCatalysts\\PayPalApi\\": [
                "src",
                "generated"
            ]
        }
    },
    "extra": {
        "branch-alias": {
            "dev-o3-client": "3.0.x-dev"
        }
    }
}
